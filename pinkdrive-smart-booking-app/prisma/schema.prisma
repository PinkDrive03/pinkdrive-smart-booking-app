generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  role      String   // "customer" | "rider"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ridesAsCustomer Ride[] @relation("CustomerRides")
  ridesAsRider    Ride[] @relation("RiderRides")
}

model Ride {
  id     String @id @default(cuid())
  vehicle String // "bike" | "auto" | "cabEconomy" | "cabPremium"
  distance Float
  fare     Float
  status   String @default("SEARCHING_FOR_RIDER") // SEARCHING_FOR_RIDER | START | ARRIVED | COMPLETED
  otp      String?

  pickupAddress   String
  pickupLatitude  Float
  pickupLongitude Float

  dropAddress   String
  dropLatitude  Float
  dropLongitude Float

  customerId String
  riderId    String?

  customer User  @relation("CustomerRides", fields: [customerId], references: [id])
  rider    User? @relation("RiderRides", fields: [riderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
